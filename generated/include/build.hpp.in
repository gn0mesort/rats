/// @cond INTERNAL
/**
 * @file build.hpp
 * @brief Dynamic Compile-Time Configuration
 * @author Alexander Rothman <[gnomesort@megate.ch](mailto:gnomesort@megate.ch)>
 * @date 2026
 */
#ifndef BUILD_HPP
#define BUILD_HPP

#mesondefine CONFIG_MESON_PROJECT_VERSION_LABEL
#mesondefine CONFIG_MESON_PROJECT_VERSION_BUILD

#define CONFIG_STRINGIFY(x) #x
#define CONFIG_STRING(x) CONFIG_STRINGIFY(x)
#ifndef CONFIG_MESON_PROJECT_VERSION_MAJOR
#  define CONFIG_MESON_PROJECT_VERSION 0
#endif
#ifndef CONFIG_MESON_PROJECT_VERSION_MINOR
#  define CONFIG_MESON_PROJECT_VERSION_MINOR 0
#endif
#ifndef CONFIG_MESON_PROJECT_VERSION_PATCH
#  define CONFIG_MESON_PROJECT_VERSION_PATCH 0
#endif
#ifndef CONFIG_MESON_PROJECT_VERSION_LABEL
#  define CONFIG_MESON_PROJECT_VERSION_LABEL "unknown"
#endif
#ifndef CONFIG_MESON_PROJECT_VERSION_BUILD
#  define CONFIG_MESON_PROJECT_VERSION_BUILD "unknown"
#endif

#define CONFIG_MESON_PROJECT_VERSION_STRING \
  CONFIG_STRING(CONFIG_MESON_PROJECT_VERSION_MAJOR) "." CONFIG_STRING(CONFIG_MESON_PROJECT_VERSION_MINOR) "." \
  CONFIG_STRING(CONFIG_MESON_PROJECT_VERSION_PATCH) "-" CONFIG_MESON_PROJECT_VERSION_LABEL "+" \
  CONFIG_MESON_PROJECT_VERSION_BUILD

#endif
/// @endcond
